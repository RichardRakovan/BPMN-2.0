<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Luxxis" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:collaboration id="Collaboration_Luxxis">
    <bpmn:participant id="Participant_Luxxis" name="Luxxis Hi-Fi Equipment" processRef="Process_OrderToFulfilled" />
    <bpmn:participant id="Participant_Customer" name="Customer" />
    <bpmn:participant id="Participant_Supplier" name="Supplier" />
    <bpmn:messageFlow id="MF_1" sourceRef="Participant_Customer" targetRef="Start_OrderReceived" />
    <bpmn:messageFlow id="MF_2" sourceRef="Participant_Customer" targetRef="Task_CorrectOrder" />
    <bpmn:messageFlow id="MF_3" sourceRef="Task_CorrectOrder" targetRef="Participant_Customer" />
    <bpmn:messageFlow id="MF_4" sourceRef="Task_InformDelay" targetRef="Participant_Customer" />
    <bpmn:messageFlow id="MF_5" sourceRef="Task_SendShipConf" targetRef="Participant_Customer" />
    <bpmn:messageFlow id="MF_6" sourceRef="Task_SendInvoice" targetRef="Participant_Customer" />
    <bpmn:messageFlow id="MF_7" sourceRef="Participant_Customer" targetRef="Event_PaymentReceived" />
    <bpmn:messageFlow id="MF_8" sourceRef="Task_OrderMissing" targetRef="Participant_Supplier" />
    <bpmn:messageFlow id="MF_9" sourceRef="Participant_Supplier" targetRef="Event_ItemsArrived" />
  </bpmn:collaboration>
  <bpmn:process id="Process_OrderToFulfilled" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Sales" name="Sales manager">
        <bpmn:flowNodeRef>Task_CorrectOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Accounting" name="Accounting">
        <bpmn:flowNodeRef>Start_OrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MergeValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_PaymentReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OrderFulfilled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CloseCase</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="Warehouse team">
        <bpmn:flowNodeRef>Task_CheckAvail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MergeShip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendShipConf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PackShip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ItemsArrived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformDelay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Avail</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_OrderReceived" name="Order received">
      <bpmn:outgoing>SF_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_OrderReceived" />
    </bpmn:startEvent>
    <bpmn:task id="Task_CheckValid" name="Check if order is valid">
      <bpmn:incoming>SF_1</bpmn:incoming>
      <bpmn:outgoing>SF_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Valid" name="Order valid?">
      <bpmn:incoming>SF_2</bpmn:incoming>
      <bpmn:outgoing>SF_3</bpmn:outgoing>
      <bpmn:outgoing>SF_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_MergeValid">
      <bpmn:incoming>SF_3</bpmn:incoming>
      <bpmn:incoming>SF_5</bpmn:incoming>
      <bpmn:outgoing>SF_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_GenInvoice" name="Create invoice">
      <bpmn:incoming>SF_7</bpmn:incoming>
      <bpmn:outgoing>SF_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Task_SendInvoice" name="Send invoice to customer">
      <bpmn:incoming>SF_19</bpmn:incoming>
      <bpmn:outgoing>SF_20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_PaymentReceived" name="Payment received">
      <bpmn:incoming>SF_20</bpmn:incoming>
      <bpmn:outgoing>SF_21</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Event_PaymentReceived" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_OrderFulfilled" name="Order fulfilled">
      <bpmn:incoming>SF_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_CheckAvail" name="Check if ordered items are available">
      <bpmn:incoming>SF_8</bpmn:incoming>
      <bpmn:outgoing>SF_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Task_OrderMissing" name="Order missing items from supplier">
      <bpmn:incoming>SF_12</bpmn:incoming>
      <bpmn:outgoing>SF_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="GW_MergeShip">
      <bpmn:incoming>SF_11</bpmn:incoming>
      <bpmn:incoming>SF_15</bpmn:incoming>
      <bpmn:outgoing>SF_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_SendShipConf" name="Send shipping confirmation to customer">
      <bpmn:incoming>SF_17</bpmn:incoming>
      <bpmn:outgoing>SF_18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="SF_1" sourceRef="Start_OrderReceived" targetRef="Task_CheckValid" />
    <bpmn:sequenceFlow id="SF_2" sourceRef="Task_CheckValid" targetRef="GW_Valid" />
    <bpmn:sequenceFlow id="SF_3" name="YES" sourceRef="GW_Valid" targetRef="GW_MergeValid" />
    <bpmn:sequenceFlow id="SF_4" name="NO" sourceRef="GW_Valid" targetRef="Task_CorrectOrder" />
    <bpmn:sequenceFlow id="SF_5" sourceRef="Task_CorrectOrder" targetRef="GW_MergeValid" />
    <bpmn:sequenceFlow id="SF_6" sourceRef="GW_MergeValid" targetRef="GW_Split" />
    <bpmn:sequenceFlow id="SF_7" sourceRef="GW_Split" targetRef="Task_GenInvoice" />
    <bpmn:sequenceFlow id="SF_8" sourceRef="GW_Split" targetRef="Task_CheckAvail" />
    <bpmn:sequenceFlow id="SF_9" sourceRef="Task_GenInvoice" targetRef="GW_Join" />
    <bpmn:sequenceFlow id="SF_10" sourceRef="Task_CheckAvail" targetRef="GW_Avail" />
    <bpmn:sequenceFlow id="SF_11" name="YES" sourceRef="GW_Avail" targetRef="GW_MergeShip" />
    <bpmn:sequenceFlow id="SF_12" name="NO" sourceRef="GW_Avail" targetRef="Task_OrderMissing" />
    <bpmn:sequenceFlow id="SF_13" sourceRef="Task_OrderMissing" targetRef="Task_InformDelay" />
    <bpmn:sequenceFlow id="SF_14" sourceRef="Task_InformDelay" targetRef="Event_ItemsArrived" />
    <bpmn:sequenceFlow id="SF_15" sourceRef="Event_ItemsArrived" targetRef="GW_MergeShip" />
    <bpmn:sequenceFlow id="SF_16" sourceRef="GW_MergeShip" targetRef="Task_PackShip" />
    <bpmn:sequenceFlow id="SF_17" sourceRef="Task_PackShip" targetRef="Task_SendShipConf" />
    <bpmn:sequenceFlow id="SF_18" sourceRef="Task_SendShipConf" targetRef="GW_Join" />
    <bpmn:sequenceFlow id="SF_19" sourceRef="GW_Join" targetRef="Task_SendInvoice" />
    <bpmn:sequenceFlow id="SF_20" sourceRef="Task_SendInvoice" targetRef="Event_PaymentReceived" />
    <bpmn:sequenceFlow id="SF_21" sourceRef="Event_PaymentReceived" targetRef="Task_CloseCase" />
    <bpmn:sequenceFlow id="SF_22" sourceRef="Task_CloseCase" targetRef="End_OrderFulfilled" />
    <bpmn:parallelGateway id="GW_Split">
      <bpmn:incoming>SF_6</bpmn:incoming>
      <bpmn:outgoing>SF_7</bpmn:outgoing>
      <bpmn:outgoing>SF_8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_CorrectOrder" name="Contact customer and correct order">
      <bpmn:incoming>SF_4</bpmn:incoming>
      <bpmn:outgoing>SF_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_PackShip" name="Pack and ship items">
      <bpmn:incoming>SF_16</bpmn:incoming>
      <bpmn:outgoing>SF_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Event_ItemsArrived" name="Ordered items arrived">
      <bpmn:incoming>SF_14</bpmn:incoming>
      <bpmn:outgoing>SF_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Event_ItemsArrived" />
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="GW_Join">
      <bpmn:incoming>SF_9</bpmn:incoming>
      <bpmn:incoming>SF_18</bpmn:incoming>
      <bpmn:outgoing>SF_19</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_CloseCase" name="Close the case">
      <bpmn:incoming>SF_21</bpmn:incoming>
      <bpmn:outgoing>SF_22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Task_InformDelay" name="Inform customer about delayed delivery">
      <bpmn:incoming>SF_13</bpmn:incoming>
      <bpmn:outgoing>SF_14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="GW_Avail" name="Items available?">
      <bpmn:incoming>SF_10</bpmn:incoming>
      <bpmn:outgoing>SF_11</bpmn:outgoing>
      <bpmn:outgoing>SF_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
  </bpmn:process>
